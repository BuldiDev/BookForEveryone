{% extends 'layout/app.html.twig' %}

{% block title %}Feed - BookForEveryone{% endblock %}

{% block page_content %}
<div class="feed-area">
    {# Area centrale #}
    <div class="feed-center">
        {# Tab di navigazione #}
        <div class="feed-tabs">
            <a href="{{ path('app_feed', {section: 'seguiti'}) }}" class="feed-tab {{ section == 'seguiti' ? 'is-active' : '' }}">Seguiti</a>
            <a href="{{ path('app_feed', {section: 'per-te'}) }}" class="feed-tab {{ section == 'per-te' ? 'is-active' : '' }}">Per te</a>
        </div>

        <div class="feed-scroll" id="feed" data-section="{{ section }}">
            {% for book in books %}
                <div class="feed-item" data-book-id="{{ book.id }}" data-index="{{ loop.index0 }}">
                    {% include 'components/feed_item.html.twig' with {'book': book, 'user_book': userBooks[book.id] ?? null, 'stats': bookStats[book.id] ?? {avg_rating: null, likes_count: 0}} %}
                </div>
            {% else %}
                <div class="feed-item">
                    <div class="feed-card__placeholder">
                        <div>
                            {% if section == 'seguiti' %}
                                <h2>Nessun libro dai seguiti</h2>
                                <p style="font-size: 1rem; margin-top: 8px;">Segui altri utenti per vedere i libri che suggeriscono.</p>
                            {% else %}
                                <h2>Nessun libro trovato</h2>
                                <p style="font-size: 1rem; margin-top: 8px;">Prova a seguire nuovi generi o aggiungere libri.</p>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

    {# Frecce navigazione - colonna separata a destra #}
    <div class="feed-nav-arrows">
        <button class="feed-nav-arrow" id="feed-prev" title="Precedente">
            <svg viewBox="0 0 24 24"><path d="M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z"/></svg>
        </button>
        <button class="feed-nav-arrow" id="feed-next" title="Successivo">
            <svg viewBox="0 0 24 24"><path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6z"/></svg>
        </button>
    </div>
</div>
{% endblock %}
