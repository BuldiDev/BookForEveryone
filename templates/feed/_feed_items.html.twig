{#
    Partial: lista di item del feed.
    Usato per il caricamento incrementale via Turbo/AJAX.
    Itera su `books` e include components/feed_item.html.twig per ciascuno.
    Variabili attese: books, userBooks, bookStats, followingIds, userReviews.
#}
{% for book in books %}
    <div class="feed-item" data-book-id="{{ book.id }}">
        {% include 'components/feed_item.html.twig' with {'book': book, 'user_book': userBooks[book.id] ?? null, 'stats': bookStats[book.id] ?? {avg_rating: null, likes_count: 0}, 'followingIds': followingIds, 'user_review': userReviews[book.id] ?? null} %}
    </div>
{% endfor %}
