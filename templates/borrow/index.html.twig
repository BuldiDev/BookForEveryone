{% extends 'layout/app.html.twig' %}

{% block title %}Prendi in prestito - BookForEveryone{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
{% endblock %}

{% block page_content %}
<div class="borrow-page">
    <div class="borrow-sidebar">
        <h2 class="borrow-sidebar__title">Prendi in prestito</h2>

        <div class="borrow-controls">
            <label class="borrow-label">Raggio di ricerca</label>
            <div class="borrow-range-wrap">
                <input type="range" id="radius-slider" min="1" max="50" value="25" class="borrow-range">
                <span id="radius-value" class="borrow-range-val">25 km</span>
            </div>
        </div>

        {% if not hasLocation %}
            <div class="borrow-notice">
                <p>Non hai impostato la tua posizione. Clicca sulla mappa per scegliere dove cercare, oppure imposta la posizione nelle <a href="{{ path('app_settings') }}" style="color: var(--color-primary); font-weight: 600;">impostazioni</a>.</p>
            </div>
        {% endif %}

        <div class="borrow-list" id="borrow-list">
            {% if nearbyBooks is empty %}
                <div class="borrow-empty">
                    <p>Nessun libro disponibile nelle vicinanze.</p>
                    <p class="text-muted" style="font-size: .85rem; margin-top: 4px;">Prova ad aumentare il raggio di ricerca.</p>
                </div>
            {% else %}
                {% for item in nearbyBooks %}
                    <div class="borrow-card" data-lat="{{ item.owner.latitude }}" data-lng="{{ item.owner.longitude }}" data-book-id="{{ item.book.id }}" data-owner-id="{{ item.owner.id }}">
                        <a href="{{ path('app_book_show', {id: item.book.id}) }}" class="borrow-card__link">
                        <div class="borrow-card__cover">
                            {% if item.book.coverUrl %}
                                <img src="{{ item.book.coverUrl }}" alt="{{ item.book.title }}">
                            {% else %}
                                <div class="borrow-card__no-cover">📚</div>
                            {% endif %}
                        </div>
                        <div class="borrow-card__info">
                            <div class="borrow-card__title">{{ item.book.title }}</div>
                            <div class="borrow-card__author">{{ item.book.bookAuthor }}</div>
                            <div class="borrow-card__owner">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                                {{ item.owner.displayName }}
                            </div>
                            <div class="borrow-card__distance">📍 {{ item.distance }} km</div>
                        </div>
                        </a>
                        <form action="{{ path('app_loan_request_new', {bookId: item.book.id, ownerId: item.owner.id}) }}" method="post" class="borrow-card__loan-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('loan_request_new') }}">
                            <button type="submit" class="btn btn--primary btn--sm borrow-card__loan-btn" title="Chiedi in prestito (1 Culture Point)">
                                📖 Chiedi prestito <span class="borrow-card__loan-cost">-1 ✨</span>
                            </button>
                        </form>
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </div>

    <div class="borrow-map-area">
        <div id="borrow-map" class="borrow-map"></div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        let searchLat = {{ userLat ?? 'null' }};
        let searchLng = {{ userLng ?? 'null' }};
        const hasLocation = {{ hasLocation ? 'true' : 'false' }};

        const defaultLat = searchLat ?? 41.9028;
        const defaultLng = searchLng ?? 12.4964;

        const map = L.map('borrow-map').setView([defaultLat, defaultLng], hasLocation ? 11 : 6);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap'
        }).addTo(map);

        // Leaflet ha bisogno di ricalcolare le dimensioni dopo il rendering
        setTimeout(function() { map.invalidateSize(); }, 200);

        let userMarker = null;

        // Marker utente
        function setUserMarker(lat, lng) {
            if (userMarker) map.removeLayer(userMarker);
            userMarker = L.circleMarker([lat, lng], {
                radius: 8, fillColor: '#4a9eff', color: '#fff', weight: 2, fillOpacity: 0.9
            }).addTo(map).bindPopup('Posizione di ricerca');
            searchLat = lat;
            searchLng = lng;
        }

        if (hasLocation) {
            setUserMarker(searchLat, searchLng);
        }

        const markersLayer = L.layerGroup().addTo(map);

        // Click sulla mappa → imposta posizione di ricerca e cerca libri vicini
        map.on('click', function (e) {
            setUserMarker(e.latlng.lat, e.latlng.lng);
            map.setView(e.latlng, Math.max(map.getZoom(), 11));

            const radius = parseInt(document.getElementById('radius-slider').value);
            updateRadiusCircle(radius);
            searchNearby(e.latlng.lat, e.latlng.lng, radius);

            // Nascondi il messaggio "non hai impostato la posizione"
            const notice = document.querySelector('.borrow-notice');
            if (notice) notice.style.display = 'none';
        });

        // CSRF token statico per le richieste di prestito (JS)
        const loanCsrfToken = {{ csrf_token('loan_request_new')|json_encode|raw }};

        // Carica marker iniziali
        const initialBooks = {{ nearbyBooks|map(item => {
            bookId: item.book.id,
            title: item.book.title,
            author: item.book.bookAuthor,
            coverUrl: item.book.coverUrl,
            ownerUsername: item.owner.username,
            ownerDisplayName: item.owner.displayName,
            ownerId: item.owner.id,
            ownerLat: item.owner.latitude,
            ownerLng: item.owner.longitude,
            distance: item.distance
        })|json_encode|raw }};

        function addMarkers(books) {
            markersLayer.clearLayers();
            books.forEach(item => {
                if (item.ownerLat && item.ownerLng) {
                    const marker = L.marker([item.ownerLat, item.ownerLng]).addTo(markersLayer);
                    marker.bindPopup(
                        '<strong>' + item.title + '</strong><br>' +
                        '<em>' + item.author + '</em><br>' +
                        '<span style="color:#888;">da ' + item.ownerDisplayName + '</span><br>' +
                        '<a href="/book/' + item.bookId + '" style="color:#4a9eff;">Vai al libro →</a><br>' +
                        '<form method="post" action="/loan-request/new/' + item.bookId + '/' + item.ownerId + '" style="margin-top:6px;">'
                        + '<input type="hidden" name="_token" value="' + loanCsrfToken + '">'
                        + '<button type="submit" style="cursor:pointer;padding:4px 10px;border-radius:6px;border:none;background:#4a9eff;color:#fff;font-size:.8rem;">📖 Chiedi prestito</button>'
                        + '</form>'
                    );
                }
            });
        }

        addMarkers(initialBooks);

        // Raggio slider
        const slider = document.getElementById('radius-slider');
        const radiusVal = document.getElementById('radius-value');
        let radiusCircle = null;

        function updateRadiusCircle(radius) {
            if (radiusCircle) map.removeLayer(radiusCircle);
            if (searchLat !== null && searchLng !== null) {
                radiusCircle = L.circle([searchLat, searchLng], {
                    radius: radius * 1000,
                    color: '#4a9eff',
                    fillColor: '#4a9eff',
                    fillOpacity: 0.05,
                    weight: 1,
                    interactive: false
                }).addTo(map);
            }
        }

        function searchNearby(lat, lng, radius) {
            fetch('/borrow/search?lat=' + lat + '&lng=' + lng + '&radius=' + radius)
                .then(r => r.json())
                .then(data => {
                    addMarkers(data);
                    updateBookList(data);
                });
        }

        updateRadiusCircle(parseInt(slider.value));

        let searchTimer;
        slider.addEventListener('input', function () {
            const radius = parseInt(this.value);
            radiusVal.textContent = radius + ' km';
            updateRadiusCircle(radius);

            clearTimeout(searchTimer);
            searchTimer = setTimeout(() => {
                if (searchLat === null || searchLng === null) return;
                searchNearby(searchLat, searchLng, radius);
            }, 300);
        });

        function updateBookList(books) {
            const list = document.getElementById('borrow-list');
            if (books.length === 0) {
                list.innerHTML = '<div class="borrow-empty"><p>Nessun libro disponibile nelle vicinanze.</p><p class="text-muted" style="font-size:.85rem;margin-top:4px;">Prova ad aumentare il raggio di ricerca.</p></div>';
                return;
            }
            list.innerHTML = books.map(item =>
                '<div class="borrow-card" data-lat="' + item.ownerLat + '" data-lng="' + item.ownerLng + '" data-book-id="' + item.bookId + '" data-owner-id="' + item.ownerId + '">'
                + '<a href="/book/' + item.bookId + '" class="borrow-card__link">'
                + '<div class="borrow-card__cover">'
                + (item.coverUrl ? '<img src="' + item.coverUrl + '" alt="' + item.title + '">' : '<div class="borrow-card__no-cover">📚</div>')
                + '</div>'
                + '<div class="borrow-card__info">'
                + '<div class="borrow-card__title">' + item.title + '</div>'
                + '<div class="borrow-card__author">' + item.author + '</div>'
                + '<div class="borrow-card__owner"><svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg> ' + item.ownerDisplayName + '</div>'
                + '<div class="borrow-card__distance">📍 ' + item.distance + ' km</div>'
                + '</div></a>'
                + '<form method="post" action="/loan-request/new/' + item.bookId + '/' + item.ownerId + '" class="borrow-card__loan-form">'
                + '<input type="hidden" name="_token" value="' + loanCsrfToken + '">'
                + '<button type="submit" class="btn btn--primary btn--sm borrow-card__loan-btn">📖 Chiedi prestito <span class="borrow-card__loan-cost">-1 ✨</span></button>'
                + '</form>'
                + '</div>'
            ).join('');
        }

        // Hover su un card → evidenzia marker
        document.getElementById('borrow-list').addEventListener('mouseover', function(e) {
            const card = e.target.closest('.borrow-card');
            if (card) {
                const lat = parseFloat(card.dataset.lat);
                const lng = parseFloat(card.dataset.lng);
                markersLayer.eachLayer(m => {
                    if (Math.abs(m.getLatLng().lat - lat) < 0.0001 && Math.abs(m.getLatLng().lng - lng) < 0.0001) {
                        m.openPopup();
                    }
                });
            }
        });
    });
    </script>
{% endblock %}
