{% extends 'layout/app.html.twig' %}

{% block title %}Prendi in prestito - BookForEveryone{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
{% endblock %}

{% block page_content %}
<div class="borrow-page">
    <div class="borrow-sidebar">
        <h2 class="borrow-sidebar__title">Prendi in prestito</h2>

        {# Campo di ricerca #}
        <div class="borrow-search-form" id="search-form">
            <input 
                type="text" 
                class="borrow-search-input" 
                placeholder="Cerca per titolo o autore..." 
                id="search-input"
                autocomplete="off"
                autofocus
            >
            <button type="button" class="borrow-search-btn" id="search-btn">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                    <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                </svg>
            </button>
        </div>

        {# Contenitore risultati / dettaglio #}
        <div id="borrow-content">
            {# Stato iniziale #}
            <div class="borrow-empty" id="borrow-placeholder">
                <svg viewBox="0 0 24 24" width="64" height="64" fill="var(--color-text-muted)" style="margin: 0 auto var(--spacing-md);">
                    <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                </svg>
                <h3 style="color: var(--color-text); margin-bottom: var(--spacing-sm);">Cerca un libro</h3>
                <p style="color: var(--color-text-muted); font-size: var(--font-sm);">
                    Inserisci il titolo o l'autore del libro che cerchi.<br>
                    Poi selezionalo per vedere chi ce l'ha vicino a te!
                </p>
            </div>

            {# Lista risultati libri (step 1) #}
            <div id="book-results" style="display:none;"></div>

            {# Dettaglio libro con proprietari (step 2) #}
            <div id="book-detail" style="display:none;"></div>
        </div>
    </div>

    <div class="borrow-map-area">
        <div id="borrow-map" class="borrow-map" style="display:none;"></div>
        <div id="map-placeholder" style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: var(--color-bg);">
            <div style="text-align: center; color: var(--color-text-muted);">
                <svg viewBox="0 0 24 24" width="80" height="80" fill="currentColor" style="opacity: 0.3;">
                    <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
                <p style="margin-top: var(--spacing-md); font-size: var(--font-sm);">Seleziona un libro per vedere chi ce l'ha vicino a te</p>
            </div>
        </div>
    </div>
</div>

{# ── Modal offerta ── #}
<div class="offer-modal-overlay" id="offer-modal" style="display:none;">
    <div class="offer-modal">
        <button type="button" class="offer-modal__close" id="offer-modal-close">&times;</button>
        <div class="offer-modal__book" id="offer-modal-book"></div>
        <div class="offer-modal__recipient">
            <span class="offer-modal__to-label">Offerta a</span>
            <span class="offer-modal__to-name" id="offer-modal-name"></span>
        </div>
        <div class="offer-modal__field">
            <label class="offer-modal__label" for="offer-modal-points">Quanti Culture Points vuoi offrire?</label>
            <div class="offer-modal__input-wrap">
                <button type="button" class="offer-modal__stepper" id="offer-minus">−</button>
                <input type="number" id="offer-modal-points" class="offer-modal__input" min="1" max="999" value="3">
                <button type="button" class="offer-modal__stepper" id="offer-plus">+</button>
            </div>
            <span class="offer-modal__cp-hint">Culture Points</span>
        </div>
        <form id="offer-modal-form" method="post">
            <input type="hidden" name="_token" id="offer-modal-token">
            <input type="hidden" name="offered_points" id="offer-modal-points-hidden" value="3">
            <button type="submit" class="offer-modal__submit">Invia offerta</button>
        </form>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
    (function () {
        let map = null;
        let markersLayer = null;
        let radiusCircle = null;
        let userMarker = null;
        let searchLat = {{ userLat ?? 'null' }};
        let searchLng = {{ userLng ?? 'null' }};
        const hasLocation = {{ hasLocation ? 'true' : 'false' }};
        const loanCsrfToken = {{ csrf_token('loan_request_new')|json_encode|raw }};
        let selectedBookId = null;
        let currentRadius = 25;
        let currentBookData = null;

        function destroyMap() {
            if (map) { map.remove(); map = null; }
            markersLayer = null;
            radiusCircle = null;
            userMarker = null;
        }

        // === STEP 1: Ricerca libri ===
        const searchInput = document.getElementById('search-input');
        const bookResults = document.getElementById('book-results');
        const bookDetail = document.getElementById('book-detail');
        const placeholder = document.getElementById('borrow-placeholder');
        const mapEl = document.getElementById('borrow-map');
        const mapPlaceholder = document.getElementById('map-placeholder');
        let searchTimer;

        function showStep(step) {
            placeholder.style.display = step === 'placeholder' ? '' : 'none';
            bookResults.style.display = step === 'results' ? '' : 'none';
            bookDetail.style.display = step === 'detail' ? '' : 'none';
            mapEl.style.display = step === 'detail' ? '' : 'none';
            mapPlaceholder.style.display = step === 'detail' ? 'none' : 'flex';
        }

        function searchBooks(query) {
            if (query.length < 2) {
                showStep('placeholder');
                return;
            }
            fetch('/borrow/search-books?q=' + encodeURIComponent(query))
                .then(r => r.json())
                .then(books => {
                    if (books.length === 0) {
                        bookResults.innerHTML = '<div class="borrow-empty"><p>Nessun libro trovato per "' + escapeHtml(query) + '"</p></div>';
                    } else {
                        bookResults.innerHTML = '<p class="borrow-results-count">'
                            + 'Trovati <strong>' + books.length + ' ' + (books.length === 1 ? 'libro' : 'libri') + '</strong></p>'
                            + books.map(b => renderBookResult(b)).join('');
                    }
                    showStep('results');
                    attachBookClickListeners();
                });
        }

        function renderBookResult(book) {
            const cover = book.cover
                ? '<img src="' + escapeHtml(book.cover) + '" alt="" class="borrow-result__cover">'
                : '<div class="borrow-result__cover borrow-result__cover--placeholder"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" opacity=".4"><path d="M21 5c-1.11-.35-2.33-.5-3.5-.5-1.95 0-4.05.4-5.5 1.5-1.45-1.1-3.55-1.5-5.5-1.5S2.45 4.9 1 6v14.65c0 .25.25.5.5.5.1 0 .15-.05.25-.05C3.1 20.45 5.05 20 6.5 20c1.95 0 4.05.4 5.5 1.5 1.35-.85 3.8-1.5 5.5-1.5 1.65 0 3.35.3 4.75 1.05.1.05.15.05.25.05.25 0 .5-.25.5-.5V6c-.6-.45-1.25-.75-2-1zm0 13.5c-1.1-.35-2.3-.5-3.5-.5-1.7 0-4.15.65-5.5 1.5V8c1.35-.85 3.8-1.5 5.5-1.5 1.2 0 2.4.15 3.5.5v11.5z"/></svg></div>';
            return '<div class="borrow-result" data-book-id="' + book.id + '">'
                + cover
                + '<div class="borrow-result__info">'
                + '<div class="borrow-result__title">' + escapeHtml(book.title) + '</div>'
                + '<div class="borrow-result__author">' + escapeHtml(book.author) + '</div>'
                + '</div>'
                + '<svg class="borrow-result__arrow" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"/></svg>'
                + '</div>';
        }

        function attachBookClickListeners() {
            document.querySelectorAll('.borrow-result').forEach(el => {
                el.addEventListener('click', function() {
                    const bookId = parseInt(this.dataset.bookId);
                    selectBook(bookId);
                });
            });
        }

        searchInput.addEventListener('input', function() {
            clearTimeout(searchTimer);
            selectedBookId = null;
            const q = this.value.trim();
            searchTimer = setTimeout(() => searchBooks(q), 300);
        });

        searchInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                clearTimeout(searchTimer);
                searchBooks(this.value.trim());
            }
        });

        // === STEP 2: Dettaglio libro con proprietari ===
        function selectBook(bookId) {
            selectedBookId = bookId;
            const lat = searchLat ?? 0;
            const lng = searchLng ?? 0;

            bookDetail.innerHTML = '<div class="borrow-loading">Caricamento...</div>';
            showStep('detail');

            loadOwners(bookId, lat, lng, currentRadius);
        }

        function loadOwners(bookId, lat, lng, radius) {
            fetch('/borrow/book/' + bookId + '/owners?lat=' + lat + '&lng=' + lng + '&radius=' + radius)
                .then(r => r.json())
                .then(data => {
                    currentBookData = data.book;
                    renderBookDetail(data);
                    initMap();
                    addOwnerMarkers(data.owners, data.book);
                });
        }

        function renderBookDetail(data) {
            const book = data.book;
            const owners = data.owners;
            const cover = book.cover
                ? '<img src="' + escapeHtml(book.cover) + '" alt="" class="book-detail__cover">'
                : '<div class="book-detail__cover book-detail__cover--placeholder"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" opacity=".4"><path d="M21 5c-1.11-.35-2.33-.5-3.5-.5-1.95 0-4.05.4-5.5 1.5-1.45-1.1-3.55-1.5-5.5-1.5S2.45 4.9 1 6v14.65c0 .25.25.5.5.5.1 0 .15-.05.25-.05C3.1 20.45 5.05 20 6.5 20c1.95 0 4.05.4 5.5 1.5 1.35-.85 3.8-1.5 5.5-1.5 1.65 0 3.35.3 4.75 1.05.1.05.15.05.25.05.25 0 .5-.25.5-.5V6c-.6-.45-1.25-.75-2-1zm0 13.5c-1.1-.35-2.3-.5-3.5-.5-1.7 0-4.15.65-5.5 1.5V8c1.35-.85 3.8-1.5 5.5-1.5 1.2 0 2.4.15 3.5.5v11.5z"/></svg></div>';

            let html = '<button class="book-detail__back" id="back-to-results">'
                + '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>'
                + ' Torna ai risultati</button>';

            html += '<div class="book-detail__header">'
                + '<a href="/book/' + book.id + '">' + cover + '</a>'
                + '<div class="book-detail__info">'
                + '<a href="/book/' + book.id + '" class="book-detail__title">' + escapeHtml(book.title) + '</a>'
                + '<div class="book-detail__author">' + escapeHtml(book.author) + '</div>'
                + '</div></div>';

            {% if not hasLocation %}
            html += '<div class="borrow-notice"><p>Non hai impostato la tua posizione. Clicca sulla mappa per scegliere dove cercare, oppure imposta la posizione nelle <a href="{{ path('app_settings') }}" style="color:var(--color-primary);font-weight:600;">impostazioni</a>.</p></div>';
            {% endif %}

            html += '<div class="borrow-controls">'
                + '<label class="borrow-label">Raggio di ricerca</label>'
                + '<div class="borrow-range-wrap">'
                + '<input type="range" id="radius-slider" min="1" max="100" value="' + currentRadius + '" class="borrow-range">'
                + '<span id="radius-value" class="borrow-range-val">' + currentRadius + ' km</span>'
                + '</div></div>';

            if (owners.length === 0) {
                html += '<div class="borrow-empty"><p>Nessuno vicino a te ha questo libro</p>'
                    + '<p class="text-muted" style="font-size:.85rem;margin-top:4px;">Prova ad aumentare il raggio di ricerca o a cliccare sulla mappa per cambiare posizione.</p></div>';
            } else {
                html += '<p class="borrow-results-count"><strong>' + owners.length + ' ' + (owners.length === 1 ? 'persona' : 'persone') + '</strong> vicino a te</p>';
                html += '<div class="borrow-owners-list">';
                owners.forEach(owner => {
                    html += renderOwnerItem(owner, data.book.id);
                });
                html += '</div>';
            }

            bookDetail.innerHTML = html;

            // Back button
            document.getElementById('back-to-results').addEventListener('click', function() {
                selectedBookId = null;
                showStep('results');
                destroyMap();
            });

            // Radius slider
            const slider = document.getElementById('radius-slider');
            if (slider) {
                const radiusVal = document.getElementById('radius-value');
                let sliderTimer;
                slider.addEventListener('input', function() {
                    currentRadius = parseInt(this.value);
                    radiusVal.textContent = currentRadius + ' km';
                    updateRadiusCircle(currentRadius);
                    clearTimeout(sliderTimer);
                    sliderTimer = setTimeout(() => {
                        if (selectedBookId && searchLat !== null) {
                            loadOwners(selectedBookId, searchLat, searchLng, currentRadius);
                        }
                    }, 400);
                });
            }

            // Owner hover → evidenzia marker
            document.querySelectorAll('.owner-item').forEach(item => {
                item.addEventListener('mouseenter', function() {
                    if (!markersLayer) return;
                    const lat = parseFloat(this.dataset.lat);
                    const lng = parseFloat(this.dataset.lng);
                    markersLayer.eachLayer(m => {
                        if (Math.abs(m.getLatLng().lat - lat) < 0.0001 && Math.abs(m.getLatLng().lng - lng) < 0.0001) {
                            m.openPopup();
                        }
                    });
                });
            });
        }

        function renderOwnerItem(owner, bookId) {
            const avatar = owner.avatarUrl
                ? '<img src="' + escapeHtml(owner.avatarUrl) + '" alt="" class="owner-item__avatar">'
                : '<div class="owner-item__avatar owner-item__avatar--placeholder">' + escapeHtml(owner.displayName.charAt(0).toUpperCase()) + '</div>';

            return '<div class="owner-item" data-lat="' + owner.userLat + '" data-lng="' + owner.userLng + '">'
                + '<a href="/profile/' + escapeHtml(owner.username) + '" class="owner-item__avatar-link">' + avatar + '</a>'
                + '<div class="owner-item__info">'
                + '<a href="/profile/' + escapeHtml(owner.username) + '" class="owner-item__name">' + escapeHtml(owner.displayName) + '</a>'
                + '<div class="owner-item__distance">' + owner.distance + ' km</div>'
                + '</div>'
                + '<button type="button" class="btn btn--primary btn--sm owner-item__loan-btn"'
                + ' data-offer-book="' + bookId + '"'
                + ' data-offer-owner="' + owner.userId + '"'
                + ' data-offer-name="' + escapeHtml(owner.displayName) + '"'
                + '>Fai un\'offerta</button>'
                + '</div>';
        }

        // === MAPPA ===
        function initMap() {
            if (map) return; // già inizializzata

            mapEl.style.display = '';
            mapPlaceholder.style.display = 'none';

            const defaultLat = searchLat ?? 41.9028;
            const defaultLng = searchLng ?? 12.4964;

            map = L.map(mapEl, { preferCanvas: true }).setView([defaultLat, defaultLng], hasLocation ? 11 : 6);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap'
            }).addTo(map);

            const ro = new ResizeObserver(() => { if (map) map.invalidateSize(); });
            ro.observe(mapEl);
            requestAnimationFrame(() => { if (map) map.invalidateSize(); });

            markersLayer = L.layerGroup().addTo(map);

            if (hasLocation) {
                setUserMarker(searchLat, searchLng);
            }

            updateRadiusCircle(currentRadius);

            map.on('click', function(e) {
                searchLat = e.latlng.lat;
                searchLng = e.latlng.lng;
                setUserMarker(searchLat, searchLng);
                map.setView(e.latlng, Math.max(map.getZoom(), 11));
                updateRadiusCircle(currentRadius);

                if (selectedBookId) {
                    loadOwners(selectedBookId, searchLat, searchLng, currentRadius);
                }

                const notice = document.querySelector('.borrow-notice');
                if (notice) notice.style.display = 'none';
            });
        }

        function setUserMarker(lat, lng) {
            if (userMarker) map.removeLayer(userMarker);
            userMarker = L.circleMarker([lat, lng], {
                radius: 8, fillColor: '#4a9eff', color: '#fff', weight: 2, fillOpacity: 0.9
            }).addTo(map).bindPopup('La tua posizione');
        }

        function updateRadiusCircle(radius) {
            if (!map) return;
            if (radiusCircle) map.removeLayer(radiusCircle);
            if (searchLat !== null && searchLng !== null) {
                radiusCircle = L.circle([searchLat, searchLng], {
                    radius: radius * 1000,
                    color: '#4a9eff', fillColor: '#4a9eff',
                    fillOpacity: 0.05, weight: 1, interactive: false
                }).addTo(map);
            }
        }

        function addOwnerMarkers(owners, book) {
            if (!markersLayer) return;
            markersLayer.clearLayers();
            owners.forEach(owner => {
                if (owner.userLat && owner.userLng) {
                    const marker = L.marker([owner.userLat, owner.userLng]).addTo(markersLayer);
                    marker.bindPopup(
                        '<div style="text-align:center;min-width:140px;">'
                        + '<strong>' + escapeHtml(owner.displayName) + '</strong><br>'
                        + '<span style="color:#888;font-size:.85rem;">' + owner.distance + ' km</span><br>'
                        + '<button class="borrow-popup-offer-btn" data-offer-book="' + book.id + '" data-offer-owner="' + owner.userId + '" data-offer-name="' + escapeHtml(owner.displayName) + '">Fai un\'offerta</button>'
                        + '</div>'
                    );
                }
            });

            // Zoom to fit
            if (owners.length > 0 && searchLat !== null) {
                const allPoints = [[searchLat, searchLng]];
                owners.forEach(o => { if (o.userLat && o.userLng) allPoints.push([o.userLat, o.userLng]); });
                if (allPoints.length > 1) {
                    map.fitBounds(allPoints, { padding: [40, 40], maxZoom: 13 });
                }
            }
        }

        function escapeHtml(str) {
            if (!str) return '';
            const d = document.createElement('div');
            d.textContent = str;
            return d.innerHTML;
        }

        function init() {
            showStep('placeholder');
        }

        // === OFFER MODAL ===
        const modal = document.getElementById('offer-modal');
        const modalClose = document.getElementById('offer-modal-close');
        const modalForm = document.getElementById('offer-modal-form');
        const modalPoints = document.getElementById('offer-modal-points');
        const modalPointsHidden = document.getElementById('offer-modal-points-hidden');
        const modalName = document.getElementById('offer-modal-name');
        const modalToken = document.getElementById('offer-modal-token');
        const modalBook = document.getElementById('offer-modal-book');
        const minusBtn = document.getElementById('offer-minus');
        const plusBtn = document.getElementById('offer-plus');

        function openOfferModal(bookId, ownerId, ownerName) {
            modalForm.action = '/loan-request/new/' + bookId + '/' + ownerId;
            modalToken.value = loanCsrfToken;
            modalName.textContent = ownerName;
            modalPoints.value = 3;
            modalPointsHidden.value = 3;

            // Show book info in modal
            if (currentBookData) {
                const b = currentBookData;
                const cover = b.cover
                    ? '<img src="' + escapeHtml(b.cover) + '" class="offer-modal__book-cover">'
                    : '<div class="offer-modal__book-cover offer-modal__book-cover--placeholder"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" opacity=".4"><path d="M21 5c-1.11-.35-2.33-.5-3.5-.5-1.95 0-4.05.4-5.5 1.5-1.45-1.1-3.55-1.5-5.5-1.5S2.45 4.9 1 6v14.65c0 .25.25.5.5.5.1 0 .15-.05.25-.05C3.1 20.45 5.05 20 6.5 20c1.95 0 4.05.4 5.5 1.5 1.35-.85 3.8-1.5 5.5-1.5 1.65 0 3.35.3 4.75 1.05.1.05.15.05.25.05.25 0 .5-.25.5-.5V6c-.6-.45-1.25-.75-2-1zm0 13.5c-1.1-.35-2.3-.5-3.5-.5-1.7 0-4.15.65-5.5 1.5V8c1.35-.85 3.8-1.5 5.5-1.5 1.2 0 2.4.15 3.5.5v11.5z"/></svg></div>';
                modalBook.innerHTML = cover
                    + '<div><div class="offer-modal__book-title">' + escapeHtml(b.title) + '</div>'
                    + '<div class="offer-modal__book-author">' + escapeHtml(b.author) + '</div></div>';
            }

            modal.style.display = '';
            requestAnimationFrame(() => {
                modal.classList.add('offer-modal-overlay--visible');
                modalPoints.focus();
                modalPoints.select();
            });
        }

        function closeOfferModal() {
            modal.classList.remove('offer-modal-overlay--visible');
            setTimeout(() => { modal.style.display = 'none'; }, 200);
        }

        modalClose.addEventListener('click', closeOfferModal);
        modal.addEventListener('click', function(e) {
            if (e.target === modal) closeOfferModal();
        });
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && modal.style.display !== 'none') closeOfferModal();
        });

        modalPoints.addEventListener('input', function() {
            modalPointsHidden.value = this.value;
        });
        minusBtn.addEventListener('click', function() {
            let v = parseInt(modalPoints.value) || 1;
            if (v > 1) { modalPoints.value = v - 1; modalPointsHidden.value = v - 1; }
        });
        plusBtn.addEventListener('click', function() {
            let v = parseInt(modalPoints.value) || 1;
            if (v < 999) { modalPoints.value = v + 1; modalPointsHidden.value = v + 1; }
        });

        // Delegate clicks on offer buttons (sidebar + map popups)
        document.addEventListener('click', function(e) {
            const btn = e.target.closest('[data-offer-book]');
            if (!btn) return;
            e.preventDefault();
            e.stopPropagation();
            openOfferModal(
                btn.dataset.offerBook,
                btn.dataset.offerOwner,
                btn.dataset.offerName
            );
        });

        document.addEventListener('DOMContentLoaded', init);
        document.addEventListener('turbo:load', init);
        document.addEventListener('turbo:before-cache', destroyMap);
    })();
    </script>
{% endblock %}
