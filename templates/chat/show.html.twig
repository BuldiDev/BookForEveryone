{# Conversazione — stile Vinted con eventi prestito inline #}
{% extends 'layout/app.html.twig' %}

{% block title %}Chat con {{ other.displayName }} — BookForEveryone{% endblock %}

{% block page_content %}
<div class="chat-page">
    {# Header conversazione #}
    <div class="chat-header">
        <a href="{{ path('app_chat') }}" class="chat-header__back">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
                <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
            </svg>
        </a>
        <a href="{{ path('app_profile', {username: other.username}) }}" class="chat-header__user">
            {% if other.avatarUrl %}
                <img src="{{ other.avatarUrl }}" alt="{{ other.displayName }}" class="chat-header__avatar">
            {% else %}
                <div class="chat-header__avatar chat-header__avatar--placeholder">
                    {{ other.displayName|first|upper }}
                </div>
            {% endif %}
            <span class="chat-header__name">{{ other.displayName }}</span>
        </a>
    </div>

    {# Turbo Stream sources: messaggi + aggiornamenti loan #}
    <turbo-stream-source src="{{ mercure('chat/conversation/' ~ conversation.id) }}"></turbo-stream-source>
    <turbo-stream-source src="{{ mercure('chat/conversation/' ~ conversation.id ~ '/loan') }}"></turbo-stream-source>

    {# ── Messaggi (testo + eventi prestito inline) ── #}
    <div class="chat-messages" id="chat-messages" data-current-user-id="{{ app.user.id }}">
        <div class="chat-messages__list" id="messages-list">
            {% for message in messages %}
                {% include 'chat/_message.html.twig' with {message: message, me: app.user} %}
            {% endfor %}
        </div>
    </div>

    {# ── Action bar prestito (se c'è una richiesta attiva) ── #}
    <div id="loan-action-bar-wrapper"
         data-action-bar-url="{{ path('app_chat_loan_action_bar', {id: conversation.id}) }}">
        {% if activeLoanRequest %}
            {% include 'chat/_loan_action_bar.html.twig' with {loanRequest: activeLoanRequest, me: app.user} %}
        {% endif %}
    </div>

    {# Form invio messaggio #}
    <form action="{{ path('app_chat_send', {id: conversation.id}) }}" method="post" class="chat-input-form" data-turbo="true">
        <input type="hidden" name="_token" value="{{ csrf_token('chat_send') }}">
        <input
            type="text"
            name="content"
            class="chat-input-form__input"
            placeholder="Scrivi un messaggio..."
            autocomplete="off"
            required
        >
        <button type="submit" class="chat-input-form__send">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
                <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
            </svg>
        </button>
    </form>
</div>

{% block javascripts %}
    {{ parent() }}
    <script>
        const chatContainer = document.getElementById('chat-messages');
        const currentUserId = chatContainer?.dataset.currentUserId;

        function scrollToBottom() {
            if (chatContainer) chatContainer.scrollTop = chatContainer.scrollHeight;
        }
        scrollToBottom();

        // ── Osserva nuovi messaggi (testo + loan event) ──
        const list = document.getElementById('messages-list');
        if (list) {
            const observer = new MutationObserver((mutations) => {
                for (const mutation of mutations) {
                    for (const node of mutation.addedNodes) {
                        if (node.nodeType !== 1) continue;

                        // Duplicate check (Mercure + redirect)
                        if (node.id && document.querySelectorAll('[id="' + node.id + '"]').length > 1) {
                            node.remove();
                            continue;
                        }

                        // Mine/theirs per bolle testo
                        if (node.classList.contains('chat-bubble')) {
                            const senderId = node.dataset.senderId;
                            node.classList.remove('chat-bubble--mine', 'chat-bubble--theirs');
                            node.classList.add(senderId === currentUserId ? 'chat-bubble--mine' : 'chat-bubble--theirs');
                        }
                    }
                }
                scrollToBottom();
            });
            observer.observe(list, { childList: true });
        }

        // ── Reset form dopo invio ──
        document.querySelector('.chat-input-form')?.addEventListener('turbo:submit-end', (e) => {
            e.target.reset();
            e.target.querySelector('.chat-input-form__input')?.focus();
        });

        // ── Ricarica action bar quando Mercure segnala un aggiornamento loan ──
        const actionBarWrapper = document.getElementById('loan-action-bar-wrapper');
        const actionBarUrl = actionBarWrapper?.dataset.actionBarUrl;

        function reloadActionBar() {
            if (!actionBarUrl) return;
            fetch(actionBarUrl, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(r => r.text())
                .then(html => {
                    if (actionBarWrapper) actionBarWrapper.innerHTML = html;
                });
        }

        const actionBarObserver = new MutationObserver((mutations) => {
            for (const m of mutations) {
                for (const node of m.addedNodes) {
                    if (node.nodeType === 1 && node.dataset?.loanReload === 'true') {
                        reloadActionBar();
                    }
                }
            }
        });
        if (actionBarWrapper) actionBarObserver.observe(actionBarWrapper, { childList: true });
    </script>
{% endblock %}
{% endblock %}
