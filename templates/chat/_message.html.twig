{# Singolo messaggio nella chat #}
<div class="chat-bubble {{ message.sender.id == me.id ? 'chat-bubble--mine' : 'chat-bubble--theirs' }}" id="message-{{ message.id }}" data-sender-id="{{ message.sender.id }}">
    <div class="chat-bubble__content">{{ message.content }}</div>
    <div class="chat-bubble__time">{{ message.createdAt|date('H:i') }}</div>
</div>
