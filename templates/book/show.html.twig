{#
    Pagina di dettaglio libro.
    Mostra cover, titolo, autore, ISBN, voto medio, descrizione, generi,
    foto degli utenti e recensioni.
    Se l'utente loggato non è l'autore del post, mostra il pulsante Segui/Seguendo.
    Variabili passate dal controller: book, reviews.
#}
{% extends 'layout/app.html.twig' %}

{% block title %}{{ book.title }} - BookForEveryone{% endblock %}

{% block page_content %}
<div class="container" style="padding-top: var(--spacing-xl); padding-bottom: 80px;">
    {# Chi ha consigliato il libro #}
    <div class="mb-md" style="display: flex; align-items: center; gap: var(--spacing-sm); padding: var(--spacing-md); background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: var(--radius-md);">
        <div style="flex: 1;">
            <p style="font-size: var(--font-sm); color: var(--color-text-muted); margin-bottom: 4px;">Consigliato da</p>
            <p style="font-weight: 600;">{{ book.addedBy.displayName }}</p>
            <p style="font-size: var(--font-sm); color: var(--color-text-muted);">@{{ book.addedBy.username }}</p>
        </div>
        {% if app.user and app.user != book.addedBy %}
            <form method="post" action="{{ path('app_follow_toggle', {id: book.addedBy.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('follow' ~ book.addedBy.id) }}">
                {% if app.user.isFollowing(book.addedBy) %}
                    <button type="submit" class="btn btn--outline btn--sm">Seguendo</button>
                {% else %}
                    <button type="submit" class="btn btn--primary btn--sm">Segui</button>
                {% endif %}
            </form>
        {% endif %}
    </div>

    <div class="flex gap-sm mb-lg" style="gap: var(--spacing-lg);">
        {% if book.coverUrl %}
            <img src="{{ book.coverUrl }}" alt="{{ book.title }}" style="width: 140px; border-radius: var(--radius-md); aspect-ratio: 2/3; object-fit: cover;">
        {% endif %}
        <div>
            <h1 style="font-size: var(--font-2xl); font-weight: 700;">{{ book.title }}</h1>
            <p class="text-muted">{{ book.bookAuthor }}</p>
            {% if book.isbn %}
                <p class="text-muted mt-sm" style="font-size: var(--font-sm);">ISBN: {{ book.isbn }}</p>
            {% endif %}
            {% if book.averageRating %}
                <p class="mt-sm" style="color: var(--color-star);">{{ book.averageRating }}/5 ({{ book.reviewsCount }})</p>
            {% endif %}
            {% if book.pageCount %}
                <p class="text-muted mt-sm">{{ book.pageCount }} pagine</p>
            {% endif %}
        </div>
    </div>

    {% if book.description %}
        <div class="mb-lg">
            <h2 style="font-size: var(--font-lg); font-weight: 600; margin-bottom: var(--spacing-sm);">Descrizione</h2>
            <p style="line-height: 1.7; color: var(--color-text-muted);">{{ book.description }}</p>
        </div>
    {% endif %}

    {% if book.genres|length > 0 %}
        <div class="mb-lg flex gap-sm" style="flex-wrap: wrap; gap: var(--spacing-sm);">
            {% for genre in book.genres %}
                <span style="padding: 4px 12px; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-full); font-size: var(--font-sm);">{{ genre.name }}</span>
            {% endfor %}
        </div>
    {% endif %}

    {# Foto degli utenti #}
    {% if book.photos|length > 0 %}
        <div class="mb-lg">
            <h2 style="font-size: var(--font-lg); font-weight: 600; margin-bottom: var(--spacing-sm);">Foto degli utenti</h2>
            <div class="user-photos-grid">
                {% for photo in book.photos %}
                    <div class="user-photo-card">
                        <img src="{{ photo.imageUrl | imagine_filter('photo_thumb') }}" alt="{{ photo.caption ?? book.title }}" class="user-photo-card__img" loading="lazy">
                        {% if photo.caption %}
                            <p class="user-photo-card__caption">{{ photo.caption }}</p>
                        {% endif %}
                        <p class="user-photo-card__user">Aggiunta da {{ photo.uploadedBy.displayName }}</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {# Sezione recensioni degli utenti #}
    <div class="mb-lg">
        <h2 style="font-size: var(--font-lg); font-weight: 600; margin-bottom: var(--spacing-sm);">Recensioni</h2>
        {% for review in reviews %}
            <div class="review-card">
                <div class="review-card__header">
                    <span class="review-card__user">{{ review.user.displayName }}</span>
                    <span class="review-card__stars">{{ review.rating }}/5</span>
                </div>
                {% if review.content %}
                    <p class="review-card__text">{{ review.content }}</p>
                {% endif %}
            </div>
        {% else %}
            <p class="text-muted">Nessuna recensione ancora.</p>
        {% endfor %}
    </div>
</div>
{% endblock %}
