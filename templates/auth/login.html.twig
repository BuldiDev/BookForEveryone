{% extends 'layout/auth.html.twig' %}

{% block title %}Accedi - BookForEveryone{% endblock %}

{% block body %}
<div class="auth-page">
    <div class="auth-card">
        <h1 class="auth-card__title">Accedi</h1>

        {% if error %}
            <div class="flash flash--error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <form method="post">
            <div class="form-group">
                <label for="inputEmail">Email</label>
                <input type="email" id="inputEmail" name="_username" value="{{ last_username }}" required autofocus class="form-control">
            </div>

            <div class="form-group">
                <label for="inputPassword">Password</label>
                <input type="password" id="inputPassword" name="_password" required class="form-control">
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="form-group">
                <label>
                    <input type="checkbox" name="_remember_me"> Ricordami
                </label>
            </div>

            <button type="submit" class="btn btn--primary btn--block">Accedi</button>
        </form>

        <p class="text-center mt-md text-muted">
            Non hai un account? <a href="{{ path('app_register') }}" style="color: var(--color-accent); font-weight: 600;">Registrati</a>
        </p>
    </div>
</div>
{% endblock %}
