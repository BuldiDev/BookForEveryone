{#
    Pagina di registrazione.
    Estende layout/auth.html.twig (senza navbar).
    Include una mappa Leaflet (OpenStreetMap) per la selezione della posizione geografica.
    La ricerca indirizzo usa l'API Nominatim con debounce a 400ms.
    I campi latitude/longitude vengono popolati via JS e inviati con il form.
    Variabili passate dal controller: registrationForm.
#}
{% extends 'layout/auth.html.twig' %}

{% block title %}Registrati - BookForEveryone{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
{% endblock %}

{% block body %}
<div class="auth-page">
    <div class="auth-card auth-card--wide">
        <h1 class="auth-card__title">Registrati</h1>

        {{ form_start(registrationForm) }}
            <div class="form-group">
                {{ form_label(registrationForm.username) }}
                {{ form_widget(registrationForm.username, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(registrationForm.username) }}
            </div>

            <div class="form-group">
                {{ form_label(registrationForm.email) }}
                {{ form_widget(registrationForm.email, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(registrationForm.email) }}
            </div>

            <div class="form-group">
                {{ form_label(registrationForm.plainPassword, 'Password') }}
                {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(registrationForm.plainPassword) }}
            </div>

            <div class="form-group">
                <label>La tua posizione <span class="text-muted" style="font-weight:400; font-size: .85rem;">(per trovare libri vicino a te)</span></label>
                <div class="map-search-wrap">
                    <input type="text" id="address-search" class="form-control" placeholder="Cerca indirizzo..." autocomplete="off">
                    <div id="address-results" class="address-results"></div>
                </div>
                <div id="register-map" style="height: 250px; border-radius: var(--radius-md); margin-top: 8px; border: 1px solid var(--color-border);"></div>
                <p class="text-muted" style="font-size: .8rem; margin-top: 4px;">Cerca un indirizzo o clicca sulla mappa per impostare la posizione.</p>
                {{ form_widget(registrationForm.latitude, {'id': 'reg-latitude'}) }}
                {{ form_widget(registrationForm.longitude, {'id': 'reg-longitude'}) }}
            </div>

            <button type="submit" class="btn btn--primary btn--block mt-md">Registrati</button>
        {{ form_end(registrationForm) }}

        <p class="text-center mt-md text-muted">
            Hai già un account? <a href="{{ path('app_login') }}" style="color: var(--color-accent); font-weight: 600;">Accedi</a>
        </p>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        const map = L.map('register-map').setView([41.9028, 12.4964], 6); // Centro Italia
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap'
        }).addTo(map);

        let marker = null;
        const latInput = document.getElementById('reg-latitude');
        const lngInput = document.getElementById('reg-longitude');

        function setMarker(lat, lng) {
            if (marker) map.removeLayer(marker);
            marker = L.marker([lat, lng]).addTo(map);
            latInput.value = lat;
            lngInput.value = lng;
        }

        map.on('click', function (e) {
            setMarker(e.latlng.lat, e.latlng.lng);
            map.setView(e.latlng, Math.max(map.getZoom(), 13));
        });

        // Ricerca indirizzo con Nominatim (debounce 400ms)
        const searchInput = document.getElementById('address-search');
        const resultsDiv = document.getElementById('address-results');
        let debounceTimer;

        searchInput.addEventListener('input', function () {
            clearTimeout(debounceTimer);
            const q = this.value.trim();
            if (q.length < 3) { resultsDiv.innerHTML = ''; return; }

            debounceTimer = setTimeout(() => {
                fetch('https://nominatim.openstreetmap.org/search?format=json&limit=5&q=' + encodeURIComponent(q), {
                    headers: { 'Accept-Language': 'it' }
                })
                .then(r => r.json())
                .then(data => {
                    resultsDiv.innerHTML = '';
                    data.forEach(item => {
                        const div = document.createElement('div');
                        div.className = 'address-result-item';
                        div.textContent = item.display_name;
                        div.addEventListener('click', () => {
                            const lat = parseFloat(item.lat);
                            const lng = parseFloat(item.lon);
                            setMarker(lat, lng);
                            map.setView([lat, lng], 14);
                            searchInput.value = item.display_name;
                            resultsDiv.innerHTML = '';
                        });
                        resultsDiv.appendChild(div);
                    });
                });
            }, 400);
        });

        document.addEventListener('click', function (e) {
            if (!searchInput.contains(e.target) && !resultsDiv.contains(e.target)) {
                resultsDiv.innerHTML = '';
            }
        });
    });
    </script>
{% endblock %}
