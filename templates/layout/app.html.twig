{# Layout con sidebar e navbar per le pagine dell'app (utente loggato) #}
{% extends 'layout/base.html.twig' %}

{% block body %}
<div class="app-layout">
    {# Sidebar sinistra (desktop) #}
    <aside class="feed-sidebar">
        <div class="feed-sidebar__logo">BookForEveryone</div>
        <nav class="feed-sidebar__nav">
            <a href="{{ path('app_feed') }}" class="feed-sidebar__link {{ app.request.attributes.get('_route') == 'app_feed' ? 'is-active' : '' }}">
                <svg viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
                <span>Per te</span>
            </a>
            <a href="{{ path('app_search') }}" class="feed-sidebar__link {{ app.request.attributes.get('_route') == 'app_search' ? 'is-active' : '' }}">
                <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0016 9.5 6.5 6.5 0 109.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                <span>Cerca</span>
            </a>
            <a href="{{ path('app_borrow') }}" class="feed-sidebar__link {{ app.request.attributes.get('_route') == 'app_borrow' ? 'is-active' : '' }}">
                <svg viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z"/></svg>
                <span>Prendi in prestito</span>
            </a>
            <a href="{{ path('app_chat') }}" class="feed-sidebar__link {{ app.request.attributes.get('_route') starts with 'app_chat' ? 'is-active' : '' }}">
                <svg viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H6l-2 2V4h16v12z"/></svg>
                <span>Chat</span>
            </a>
            <a href="{{ path('app_book_add') }}" class="feed-sidebar__link {{ app.request.attributes.get('_route') == 'app_book_add' ? 'is-active' : '' }}">
                <svg viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
                <span>Aggiungi libro</span>
            </a>
            <a href="{{ path('app_profile', {username: app.user.username}) }}" class="feed-sidebar__link {{ app.request.attributes.get('_route') == 'app_profile' ? 'is-active' : '' }}">
                <svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                <span>Profilo</span>
            </a>
            {% if app.user.isAdmin %}
            <a href="{{ path('app_admin_stats') }}" class="feed-sidebar__link feed-sidebar__link--admin {{ app.request.attributes.get('_route') starts with 'app_admin' ? 'is-active' : '' }}">
                <svg viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/></svg>
                <span>Statistiche</span>
            </a>
            {% endif %}
            <a href="{{ path('app_logout') }}" class="feed-sidebar__link">
                <svg viewBox="0 0 24 24"><path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/></svg>
                <span>Logout</span>
            </a>
        </nav>

        {# Sezione Seguiti (stile YouTube) #}
        {% if app.user.following is not empty %}
        <div class="feed-sidebar__section">
            <div class="feed-sidebar__section-title">Seguiti</div>
            <div class="feed-sidebar__subscriptions">
                {% for person in app.user.following %}
                    <a href="{{ path('app_profile', {username: person.username}) }}" class="feed-sidebar__sub-link">
                        {% if person.avatarUrl %}
                            <img src="{{ person.avatarUrl }}" alt="{{ person.displayName }}" class="feed-sidebar__sub-avatar">
                        {% else %}
                            <div class="feed-sidebar__sub-avatar feed-sidebar__sub-avatar--placeholder">
                                {{ person.displayName|first|upper }}
                            </div>
                        {% endif %}
                        <span class="feed-sidebar__sub-name">{{ person.displayName }}</span>
                    </a>
                {% endfor %}
            </div>
        </div>
        {% endif %}
    </aside>

    {# Contenuto pagina #}
    <main class="app-content">
        {# Badge punti cultura #}
        <div class="culture-badge">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M18 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 4h5v8l-2.5-1.5L6 12V4z"/></svg>
            <span>{{ app.user.culturePoints }}</span>
        </div>
        {% block page_content %}{% endblock %}
    </main>
</div>
{% endblock %}

{% block navbar %}
<nav class="navbar-bottom">
    <a href="{{ path('app_feed') }}" class="navbar-bottom__item {{ app.request.attributes.get('_route') == 'app_feed' ? 'is-active' : '' }}">
        <svg viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
        <span>Feed</span>
    </a>
    <a href="{{ path('app_search') }}" class="navbar-bottom__item {{ app.request.attributes.get('_route') == 'app_search' ? 'is-active' : '' }}">
        <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0016 9.5 6.5 6.5 0 109.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
        <span>Cerca</span>
    </a>
    <a href="{{ path('app_borrow') }}" class="navbar-bottom__item {{ app.request.attributes.get('_route') == 'app_borrow' ? 'is-active' : '' }}">
        <svg viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z"/></svg>
        <span>Prestito</span>
    </a>
    <a href="{{ path('app_chat') }}" class="navbar-bottom__item {{ app.request.attributes.get('_route') starts with 'app_chat' ? 'is-active' : '' }}">
        <svg viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H6l-2 2V4h16v12z"/></svg>
        <span>Chat</span>
    </a>
    <a href="{{ path('app_book_add') }}" class="navbar-bottom__item {{ app.request.attributes.get('_route') == 'app_book_add' ? 'is-active' : '' }}">
        <svg viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
        <span>Aggiungi</span>
    </a>
    <a href="{{ path('app_profile', {username: app.user.username}) }}" class="navbar-bottom__item {{ app.request.attributes.get('_route') == 'app_profile' ? 'is-active' : '' }}">
        <svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
        <span>Profilo</span>
    </a>
    <a href="{{ path('app_logout') }}" class="navbar-bottom__item">
        <svg viewBox="0 0 24 24"><path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/></svg>
        <span>Logout</span>
    </a>
</nav>
{% endblock %}
