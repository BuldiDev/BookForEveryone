{# Layout con sidebar e navbar per le pagine dell'app (utente loggato) #}
{% extends 'layout/base.html.twig' %}

{% block body %}
<div class="app-layout">
    {# Sidebar sinistra (desktop) #}
    <aside class="feed-sidebar">
        <div class="feed-sidebar__logo">BookForEveryone</div>
        <nav class="feed-sidebar__nav">
            <a href="{{ path('app_feed') }}" class="feed-sidebar__link {{ app.request.attributes.get('_route') == 'app_feed' ? 'is-active' : '' }}">
                <svg viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
                <span>Per te</span>
            </a>
            <a href="{{ path('app_search') }}" class="feed-sidebar__link {{ app.request.attributes.get('_route') == 'app_search' ? 'is-active' : '' }}">
                <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0016 9.5 6.5 6.5 0 109.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                <span>Cerca</span>
            </a>
            <a href="{{ path('app_book_add') }}" class="feed-sidebar__link {{ app.request.attributes.get('_route') == 'app_book_add' ? 'is-active' : '' }}">
                <svg viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
                <span>Aggiungi libro</span>
            </a>
            <a href="{{ path('app_profile', {username: app.user.username}) }}" class="feed-sidebar__link {{ app.request.attributes.get('_route') == 'app_profile' ? 'is-active' : '' }}">
                <svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                <span>Profilo</span>
            </a>
        </nav>
    </aside>

    {# Contenuto pagina #}
    <main class="app-content">
        {% block page_content %}{% endblock %}
    </main>
</div>
{% endblock %}

{% block navbar %}
<nav class="navbar-bottom">
    <a href="{{ path('app_feed') }}" class="navbar-bottom__item {{ app.request.attributes.get('_route') == 'app_feed' ? 'is-active' : '' }}">
        <svg viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
        <span>Feed</span>
    </a>
    <a href="{{ path('app_search') }}" class="navbar-bottom__item {{ app.request.attributes.get('_route') == 'app_search' ? 'is-active' : '' }}">
        <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0016 9.5 6.5 6.5 0 109.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
        <span>Cerca</span>
    </a>
    <a href="{{ path('app_book_add') }}" class="navbar-bottom__item {{ app.request.attributes.get('_route') == 'app_book_add' ? 'is-active' : '' }}">
        <svg viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
        <span>Aggiungi</span>
    </a>
    <a href="{{ path('app_profile', {username: app.user.username}) }}" class="navbar-bottom__item {{ app.request.attributes.get('_route') == 'app_profile' ? 'is-active' : '' }}">
        <svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
        <span>Profilo</span>
    </a>
</nav>
{% endblock %}
