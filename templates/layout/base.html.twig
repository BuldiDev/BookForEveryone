{#
    Template base dell'applicazione.
    Tutti gli altri layout estendono questo file.
    Definisce i blocchi: title, stylesheets, flash_messages, body, navbar, javascripts.
    I messaggi flash (successo, errore, info) sono mostrati sopra il contenuto principale.
#}
<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}BookForEveryone{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
    {# Link di salto al contenuto: invisibile finché non riceve il focus da tastiera #}
    <a href="#main-content" class="skip-link">Salta al contenuto</a>

    {# Messaggi flash di sessione: success, error, warning, info.
       role="alert" fa annunciare il messaggio dagli screen reader appena compare. #}
    {% block flash_messages %}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash flash--{{ label }}" role="alert">{{ message }}</div>
            {% endfor %}
        {% endfor %}
    {% endblock %}

    {% block body %}{% endblock %}

    {% block navbar %}{% endblock %}

    {# importmap('app') carica il bundle JS tramite Import Map di Symfony AssetMapper #}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</body>
</html>
