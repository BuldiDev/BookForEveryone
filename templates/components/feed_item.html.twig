{# Singolo item del feed TikTok-style #}
<div class="feed-item" data-book-id="{{ book.id }}">
    {# Copertina a tutto schermo #}
    {% if book.coverUrl %}
        <img src="{{ book.coverUrl }}" alt="{{ book.title }}" class="feed-item__cover">
    {% elseif book.photos|length > 0 %}
        <img src="{{ book.photos|first.imageUrl }}" alt="{{ book.title }}" class="feed-item__cover">
    {% else %}
        <div class="feed-item__cover" style="background: var(--color-primary); display: flex; align-items: center; justify-content: center; color: #fff; font-size: var(--font-2xl); font-weight: 700; text-align: center; padding: var(--spacing-lg);">
            {{ book.title }}
        </div>
    {% endif %}

    {# Overlay info in basso #}
    <div class="feed-item__overlay">
        <h2 class="feed-item__title">{{ book.title }}</h2>
        <p class="feed-item__author">{{ book.bookAuthor }}</p>
        {% if book.averageRating %}
            <div class="feed-item__rating">
                {{ book.averageRating }}/5 ({{ book.reviewsCount }} recensioni)
            </div>
        {% endif %}
    </div>

    {# Azioni laterali (destra) #}
    <div class="feed-item__actions">
        <button class="feed-action js-action-like {% if user_book and user_book.liked %}feed-action--liked{% endif %}"
                data-action="like" data-book="{{ book.id }}">
            <span class="feed-action__icon">
                <svg viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
            </span>
            <span>{{ book.likesCount }}</span>
        </button>

        <button class="feed-action js-action-read {% if user_book and user_book.hasRead %}feed-action--read{% endif %}"
                data-action="read" data-book="{{ book.id }}">
            <span class="feed-action__icon">
                <svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg>
            </span>
            <span>Letto</span>
        </button>

        <button class="feed-action js-action-own"
                data-action="own" data-book="{{ book.id }}">
            <span class="feed-action__icon">
                <svg viewBox="0 0 24 24"><path d="M18 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 18H6V4h2v8l2.5-1.5L13 12V4h5v16z"/></svg>
            </span>
            <span>Posseggo</span>
        </button>

        <button class="feed-action js-action-reviews"
                data-action="reviews" data-book="{{ book.id }}">
            <span class="feed-action__icon">
                <svg viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z"/></svg>
            </span>
            <span>Recensioni</span>
        </button>

        <button class="feed-action js-action-description"
                data-action="description" data-book="{{ book.id }}">
            <span class="feed-action__icon">
                <svg viewBox="0 0 24 24"><path d="M11 17h2v-6h-2v6zm1-15C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zM11 9h2V7h-2v2z"/></svg>
            </span>
            <span>Info</span>
        </button>

        <button class="feed-action js-action-share"
                data-action="share" data-book="{{ book.id }}">
            <span class="feed-action__icon">
                <svg viewBox="0 0 24 24"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92-1.31-2.92-2.92-2.92z"/></svg>
            </span>
            <span>Condividi</span>
        </button>
    </div>

    {# Pannello descrizione (si apre da sinistra) #}
    <div class="feed-item__description-panel" id="desc-{{ book.id }}">
        <button class="description-close" data-close-desc="{{ book.id }}">X</button>
        <h2>{{ book.title }}</h2>
        <p class="text-muted mb-md">{{ book.bookAuthor }}{% if book.publicationYear %} - {{ book.publicationYear }}{% endif %}</p>
        {% if book.description %}
            <p>{{ book.description }}</p>
        {% endif %}
        {% if book.pageCount %}
            <p class="mt-md text-muted">{{ book.pageCount }} pagine</p>
        {% endif %}
        {% if book.publisher %}
            <p class="text-muted">Editore: {{ book.publisher }}</p>
        {% endif %}
        {% if book.genres|length > 0 %}
            <p class="mt-md text-muted">
                Generi: {% for genre in book.genres %}{{ genre.name }}{% if not loop.last %}, {% endif %}{% endfor %}
            </p>
        {% endif %}
    </div>
</div>
