{#
    Pagina impostazioni profilo.
    Permette di modificare nome visualizzato, bio e posizione geografica.
    La mappa Leaflet mostra la posizione corrente dell'utente e permette di aggiornarla.
    La ricerca indirizzo usa l'API Nominatim con debounce a 400ms.
    Il form invia i dati tramite POST con token CSRF.
    Variabili passate dal controller: user.
#}
{% extends 'layout/app.html.twig' %}

{% block title %}Impostazioni - BookForEveryone{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
{% endblock %}

{% block page_content %}
<div class="container" style="max-width: 600px; margin: 0 auto; padding: var(--spacing-2xl) var(--spacing-lg); padding-bottom: 100px;">
    <h1 style="font-size: var(--font-2xl); font-weight: 700; margin-bottom: var(--spacing-lg);">Impostazioni</h1>

    <form method="post" action="{{ path('app_settings') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('settings') }}">

        <div class="form-group">
            <label>Nome visualizzato</label>
            <input type="text" name="displayName" class="form-control" value="{{ user.displayName }}" maxlength="100" placeholder="Il tuo nome...">
        </div>

        <div class="form-group">
            <label>Bio</label>
            <textarea name="bio" class="form-control" rows="3" maxlength="500" placeholder="Parlaci di te...">{{ user.bio }}</textarea>
        </div>

        <div class="form-group">
            <label>La tua posizione <span class="text-muted" style="font-weight:400; font-size: .85rem;">(per trovare libri vicino a te)</span></label>
            <div class="map-search-wrap">
                <input type="text" id="address-search" class="form-control" placeholder="Cerca indirizzo..." autocomplete="off">
                <div id="address-results" class="address-results"></div>
            </div>
            <div id="settings-map" style="height: 280px; border-radius: var(--radius-md); margin-top: 8px; border: 1px solid var(--color-border);"></div>
            <p class="text-muted" style="font-size: .8rem; margin-top: 4px;">Cerca un indirizzo o clicca sulla mappa per aggiornare la posizione.</p>
            <input type="hidden" name="latitude" id="settings-latitude" value="{{ user.latitude }}">
            <input type="hidden" name="longitude" id="settings-longitude" value="{{ user.longitude }}">
        </div>

        <button type="submit" class="btn btn--primary btn--block mt-md">Salva impostazioni</button>
    </form>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        const latInput = document.getElementById('settings-latitude');
        const lngInput = document.getElementById('settings-longitude');

        const currentLat = latInput.value ? parseFloat(latInput.value) : null;
        const currentLng = lngInput.value ? parseFloat(lngInput.value) : null;

        const startLat = currentLat ?? 41.9028;
        const startLng = currentLng ?? 12.4964;
        const startZoom = currentLat ? 13 : 6;

        const map = L.map('settings-map').setView([startLat, startLng], startZoom);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap'
        }).addTo(map);

        setTimeout(function() { map.invalidateSize(); }, 200);

        let marker = null;

        function setMarker(lat, lng) {
            if (marker) map.removeLayer(marker);
            marker = L.marker([lat, lng]).addTo(map);
            latInput.value = lat;
            lngInput.value = lng;
        }

        if (currentLat && currentLng) {
            setMarker(currentLat, currentLng);
        }

        map.on('click', function (e) {
            setMarker(e.latlng.lat, e.latlng.lng);
            map.setView(e.latlng, Math.max(map.getZoom(), 13));
        });

        // Ricerca indirizzo con Nominatim
        const searchInput = document.getElementById('address-search');
        const resultsDiv = document.getElementById('address-results');
        let debounceTimer;

        searchInput.addEventListener('input', function () {
            clearTimeout(debounceTimer);
            const q = this.value.trim();
            if (q.length < 3) { resultsDiv.innerHTML = ''; return; }

            debounceTimer = setTimeout(() => {
                fetch('https://nominatim.openstreetmap.org/search?format=json&limit=5&q=' + encodeURIComponent(q), {
                    headers: { 'Accept-Language': 'it' }
                })
                .then(r => r.json())
                .then(data => {
                    resultsDiv.innerHTML = '';
                    data.forEach(item => {
                        const div = document.createElement('div');
                        div.className = 'address-result-item';
                        div.textContent = item.display_name;
                        div.addEventListener('click', () => {
                            const lat = parseFloat(item.lat);
                            const lng = parseFloat(item.lon);
                            setMarker(lat, lng);
                            map.setView([lat, lng], 14);
                            searchInput.value = item.display_name;
                            resultsDiv.innerHTML = '';
                        });
                        resultsDiv.appendChild(div);
                    });
                });
            }, 400);
        });

        document.addEventListener('click', function (e) {
            if (!searchInput.contains(e.target) && !resultsDiv.contains(e.target)) {
                resultsDiv.innerHTML = '';
            }
        });
    });
    </script>
{% endblock %}
