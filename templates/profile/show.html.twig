{% extends 'layout/app.html.twig' %}

{% block title %}{{ user.displayName }} - BookForEveryone{% endblock %}

{% block page_content %}
<div class="profile-header">
    {% if user.avatarUrl %}
        <img src="{{ user.avatarUrl }}" alt="{{ user.username }}" class="profile-header__avatar">
    {% else %}
        <div class="profile-header__avatar" style="display: flex; align-items: center; justify-content: center; font-size: var(--font-2xl); font-weight: 700; color: #fff; background: var(--color-primary-light);">
            {{ user.username|first|upper }}
        </div>
    {% endif %}

    <h1 class="profile-header__name">{{ user.displayName }}</h1>
    <p class="profile-header__username">@{{ user.username }}</p>
    {% if user.bio %}
        <p class="profile-header__bio">{{ user.bio }}</p>
    {% endif %}

    <div class="profile-stats">
        <div class="profile-stat">
            <span class="profile-stat__count">{{ user.readBooks|length }}</span>
            <span class="profile-stat__label">Letti</span>
        </div>
        <div class="profile-stat">
            <span class="profile-stat__count">{{ user.ownedBooks|length }}</span>
            <span class="profile-stat__label">Posseduti</span>
        </div>
        <a href="{{ path('app_profile_followers', {username: user.username}) }}" class="profile-stat profile-stat--link">
            <span class="profile-stat__count">{{ user.followersCount }}</span>
            <span class="profile-stat__label">Follower</span>
        </a>
        <a href="{{ path('app_profile_following', {username: user.username}) }}" class="profile-stat profile-stat--link">
            <span class="profile-stat__count">{{ user.followingCount }}</span>
            <span class="profile-stat__label">Seguiti</span>
        </a>
    </div>

    {% if app.user and app.user != user %}
        <form method="post" action="{{ path('app_follow_toggle', {id: user.id}) }}" class="mt-md">
            <input type="hidden" name="_token" value="{{ csrf_token('follow' ~ user.id) }}">
            {% if app.user.isFollowing(user) %}
                <button type="submit" class="btn btn--outline btn--sm">Smetti di seguire</button>
            {% else %}
                <button type="submit" class="btn btn--primary btn--sm">Segui</button>
            {% endif %}
        </form>
    {% endif %}
</div>

<div class="container" style="padding-top: var(--spacing-lg); padding-bottom: 80px;">
    <h2 style="font-size: var(--font-xl); font-weight: 700; margin-bottom: var(--spacing-md);">Libri consigliati</h2>
    {% if recommendedBooks|length > 0 %}
        <div class="book-list">
            {% for book in recommendedBooks %}
                {% include 'components/book_card.html.twig' with {'book': book} %}
            {% endfor %}
        </div>
    {% else %}
        <p class="text-muted">Nessun libro consigliato ancora.</p>
    {% endif %}

    <h2 style="font-size: var(--font-xl); font-weight: 700; margin-top: var(--spacing-2xl); margin-bottom: var(--spacing-md);">Libri letti</h2>
    {% if readBooks|length > 0 %}
        <div class="book-list">
            {% for userBook in readBooks %}
                {% include 'components/book_card.html.twig' with {'book': userBook.book} %}
            {% endfor %}
        </div>
    {% else %}
        <p class="text-muted">Nessun libro letto ancora.</p>
    {% endif %}

    <h2 style="font-size: var(--font-xl); font-weight: 700; margin-top: var(--spacing-2xl); margin-bottom: var(--spacing-md);">Libri posseduti</h2>
    {% if ownedBooks|length > 0 %}
        <div class="book-list">
            {% for userBook in ownedBooks %}
                {% include 'components/book_card.html.twig' with {'book': userBook.book} %}
            {% endfor %}
        </div>
    {% else %}
        <p class="text-muted">Nessun libro posseduto ancora.</p>
    {% endif %}
</div>
{% endblock %}
