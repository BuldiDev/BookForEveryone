{#
    Pagina profilo utente.
    Mostra avatar, nome, username, bio, statistiche (letti/posseduti/follower/seguiti).
    Se l'utente loggato è un altro utente: pulsanti Segui/Smetti e Messaggio.
    Se è il proprio profilo: link alle impostazioni.
    Sezioni libro: Consigliati, Letti, Posseduti (con "Mostra altri" se > 12).
    Variabili passate dal controller: user, readCount, ownedCount, followersCount,
      followingCount, recommendedBooks, readBooks, ownedBooks.
#}
{% extends 'layout/app.html.twig' %}

{% block title %}{{ user.displayName }} - BookForEveryone{% endblock %}

{% block page_content %}
<div class="profile-header">
    {% if user.avatarUrl %}
        <img src="{{ user.avatarUrl }}" alt="{{ user.username }}" class="profile-header__avatar">
    {% else %}
        <div class="profile-header__avatar" style="display: flex; align-items: center; justify-content: center; font-size: var(--font-2xl); font-weight: 700; color: #fff; background: var(--color-primary-light);">
            {{ user.username|first|upper }}
        </div>
    {% endif %}

    <h1 class="profile-header__name">{{ user.displayName }}</h1>
    <p class="profile-header__username">@{{ user.username }}</p>
    {% if user.bio %}
        <p class="profile-header__bio">{{ user.bio }}</p>
    {% endif %}

    <div class="profile-stats">
        <div class="profile-stat">
            <span class="profile-stat__count">{{ readCount }}</span>
            <span class="profile-stat__label">Letti</span>
        </div>
        <div class="profile-stat">
            <span class="profile-stat__count">{{ ownedCount }}</span>
            <span class="profile-stat__label">Posseduti</span>
        </div>
        <a href="{{ path('app_profile_followers', {username: user.username}) }}" class="profile-stat profile-stat--link">
            <span class="profile-stat__count">{{ followersCount }}</span>
            <span class="profile-stat__label">Follower</span>
        </a>
        <a href="{{ path('app_profile_following', {username: user.username}) }}" class="profile-stat profile-stat--link">
            <span class="profile-stat__count">{{ followingCount }}</span>
            <span class="profile-stat__label">Seguiti</span>
        </a>
    </div>

    {# Azioni: Segui/Smetti e Messaggio (solo per altri utenti), Modifica profilo (proprio profilo) #}
    {% if app.user and app.user != user %}
        <div class="mt-md flex gap-sm items-center" style="justify-content: center;">
            <form method="post" action="{{ path('app_follow_toggle', {id: user.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('follow' ~ user.id) }}">
                {% if app.user.isFollowing(user) %}
                    <button type="submit" class="btn btn--outline btn--sm">Smetti di seguire</button>
                {% else %}
                    <button type="submit" class="btn btn--primary btn--sm">Segui</button>
                {% endif %}
            </form>
            <a href="{{ path('app_chat_new', {id: user.id}) }}" class="btn btn--outline btn--sm">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" style="vertical-align: -2px; margin-right: 4px;"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H6l-2 2V4h16v12z"/></svg>
                Messaggio
            </a>
        </div>
    {% elseif app.user and app.user == user %}
        <a href="{{ path('app_settings') }}" class="btn btn--outline btn--sm mt-md" style="display: inline-block;">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" style="vertical-align: -2px; margin-right: 4px;"><path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 00.12-.61l-1.92-3.32a.49.49 0 00-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.48.48 0 00-.48-.41h-3.84a.48.48 0 00-.48.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.49.49 0 00-.59.22L2.74 8.87a.48.48 0 00.12.61l2.03 1.58c-.05.3-.07.62-.07.94s.02.64.07.94l-2.03 1.58a.49.49 0 00-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.48-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6A3.6 3.6 0 1115.6 12 3.6 3.6 0 0112 15.6z"/></svg>
            Modifica profilo
        </a>
    {% endif %}
</div>

    {# Sezioni libri: consigliati, letti, posseduti #}
    <div class="container" style="padding-top: var(--spacing-lg); padding-bottom: 80px;">
        {# Sezione: libri consigliati dall'utente #}
        <h2 style="font-size: var(--font-xl); font-weight: 700; margin-bottom: var(--spacing-md);">Libri consigliati</h2>
    {% if recommendedBooks|length > 0 %}
        <div class="book-list" data-section="recommended">
            {% for book in recommendedBooks %}
                <div class="book-list-item" data-index="{{ loop.index0 }}" {% if loop.index0 >= 12 %}style="display: none;"{% endif %}>
                    {% include 'components/book_card.html.twig' with {'book': book} %}
                </div>
            {% endfor %}
        </div>
        {% if recommendedBooks|length > 12 %}
            <div style="text-align: center; margin-top: var(--spacing-md);">
                <button class="btn btn--outline show-more-btn" data-target="recommended">
                    Mostra altri ({{ recommendedBooks|length - 12 }})
                </button>
            </div>
        {% endif %}
    {% else %}
        <p class="text-muted">Nessun libro consigliato ancora.</p>
    {% endif %}

        {# Sezione: libri segnati come letti #}
        <h2 style="font-size: var(--font-xl); font-weight: 700; margin-top: var(--spacing-2xl); margin-bottom: var(--spacing-md);">Libri letti</h2>
    {% if readBooks|length > 0 %}
        <div class="book-list" data-section="read">
            {% for userBook in readBooks %}
                <div class="book-list-item" data-index="{{ loop.index0 }}" {% if loop.index0 >= 12 %}style="display: none;"{% endif %}>
                    {% include 'components/book_card.html.twig' with {'book': userBook.book} %}
                </div>
            {% endfor %}
        </div>
        {% if readBooks|length > 12 %}
            <div style="text-align: center; margin-top: var(--spacing-md);">
                <button class="btn btn--outline show-more-btn" data-target="read">
                    Mostra altri ({{ readBooks|length - 12 }})
                </button>
            </div>
        {% endif %}
    {% else %}
        <p class="text-muted">Nessun libro letto ancora.</p>
    {% endif %}

        {# Sezione: libri posseduti fisicamente #}
        <h2 style="font-size: var(--font-xl); font-weight: 700; margin-top: var(--spacing-2xl); margin-bottom: var(--spacing-md);">Libri posseduti</h2>
    {% if ownedBooks|length > 0 %}
        <div class="book-list" data-section="owned">
            {% for userBook in ownedBooks %}
                <div class="book-list-item" data-index="{{ loop.index0 }}" {% if loop.index0 >= 12 %}style="display: none;"{% endif %}>
                    {% include 'components/book_card.html.twig' with {'book': userBook.book} %}
                </div>
            {% endfor %}
        </div>
        {% if ownedBooks|length > 12 %}
            <div style="text-align: center; margin-top: var(--spacing-md);">
                <button class="btn btn--outline show-more-btn" data-target="owned">
                    Mostra altri ({{ ownedBooks|length - 12 }})
                </button>
            </div>
        {% endif %}
    {% else %}
        <p class="text-muted">Nessun libro posseduto ancora.</p>
    {% endif %}
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.show-more-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const target = this.dataset.target;
            const section = document.querySelector(`.book-list[data-section="${target}"]`);
            
            if (section) {
                section.querySelectorAll('.book-list-item[data-index]').forEach(item => {
                    item.style.display = '';
                });
                this.parentElement.remove();
            }
        });
    });
});
</script>
{% endblock %}
